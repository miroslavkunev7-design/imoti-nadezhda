# ═══════════════════════════════════════════════════════════════
# IMOTI NADEZHDA — Пълен списък от env vars за Vercel
# ═══════════════════════════════════════════════════════════════

# ── Supabase / PostgreSQL ───────────────────────────────────────
# Свържи автоматично от Vercel Dashboard → Storage → Supabase → Connect
POSTGRES_URL=
DATABASE_URL=
POSTGRES_URL_NON_POOLING=

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Site URL ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://imotinadezhda.bg
NEXT_PUBLIC_MEDIA_URL=https://res.cloudinary.com/djh3tkfuu

# ── Контакти ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME=Имоти Надежда
NEXT_PUBLIC_CONTACT_PHONE=+359899620262
NEXT_PUBLIC_CONTACT_EMAIL=agenciq_nadejdi@abv.bg
NEXT_PUBLIC_CONTACT_ADDRESS=гр. Бургас, ул. Примерна 123

# ── Admin панел ─────────────────────────────────────────────────
ADMIN_EMAIL=imoti_nadejdi@abv.bg
ADMIN_PASSWORD=
NEXTAUTH_SECRET=

# ── Cloudinary (качване на снимки) ──────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=djh3tkfuu
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=ml_default

# ── AI — Милена (незадължително) ────────────────────────────────
# Може да се добави от Admin → Настройки → Милена AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Vercel AI Gateway ключ (вграден — не е нужно да се променя)
VERCEL_AI_GATEWAY_KEY=
MILENA_GATEWAY_MODEL=openai/gpt-4o

# ── Email (ипотечни заявки) — незадължително ────────────────────
# Ако не е зададено, системата работи без имейл нотификации
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MORTGAGE_EMAIL_OBB=
MORTGAGE_EMAIL_IBANK=
MORTGAGE_EMAIL_CC=

# ── SEO (незадължително) ────────────────────────────────────────
GOOGLE_SITE_VERIFICATION=
